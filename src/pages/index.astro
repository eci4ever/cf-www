---
import Layout from "../layouts/Layout.astro";
import Header from "../components/home/Header.astro";
import Hero from "../components/home/Hero.astro";
import Projects from "../components/home/Projects.astro";
import BlogRow from "../components/home/BlogRow.astro";
import Footer from "../components/home/Footer.astro";
---

<Layout title="Nimfi.dev — Build smarter. Host faster." description="Nimfi.dev builds software, AI products, and cloud infrastructure for businesses — hosted on Cloudflare, secured from day one.">
  <div class="relative flex min-h-svh flex-col overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div class="absolute left-1/2 top-[-240px] size-[720px] -translate-x-1/2 rounded-full bg-[var(--glow)] blur-[140px]"></div>
      <div class="absolute left-[16%] top-[-160px] size-[420px] rounded-full bg-[var(--glow)] opacity-70 blur-[120px]"></div>
      <div class="absolute right-[14%] top-[-120px] size-[380px] rounded-full bg-[var(--glow)] opacity-50 blur-[120px]"></div>
    </div>
    <div
      class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_right,color-mix(in_oklab,var(--line)_50%,transparent)_1px,transparent_1px),linear-gradient(to_bottom,color-mix(in_oklab,var(--line)_50%,transparent)_1px,transparent_1px)] bg-[size:72px_72px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,black,transparent)]"
      aria-hidden="true"
    >
    </div>

    <Header />
    <main id="main" class="flex flex-1 flex-col justify-center">
      <Hero />
      <Projects />
      <BlogRow />
    </main>
    <Footer />
  </div>
</Layout>
