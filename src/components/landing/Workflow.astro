---
const steps = [
  {
    number: "01",
    title: "Discover",
    description: "Plan the product, requirements, users, architecture, and technical direction.",
    color: "cyan",
  },
  {
    number: "02",
    title: "Build",
    description: "Develop the software, platform, API, website, dashboard, or automation workflow.",
    color: "blue",
  },
  {
    number: "03",
    title: "Deploy",
    description: "Launch on reliable web or cloud hosting with performance and scalability in mind.",
    color: "purple",
  },
  {
    number: "04",
    title: "Secure",
    description: "Apply cybersecurity best practices, access control, monitoring, and system hardening.",
    color: "green",
  },
  {
    number: "05",
    title: "Improve",
    description: "Maintain, optimize, integrate, and enhance the platform over time.",
    color: "cyan",
  },
];
---

<section class="relative px-4 py-24 sm:py-32">
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <h2 class="mb-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        From idea to secure production.
      </h2>
      <p class="text-lg leading-relaxed text-slate-400">
        A clear technical workflow designed to help businesses plan, build, launch, and protect their digital products.
      </p>
    </div>

    <div class="flex flex-col gap-4 lg:flex-row">
      {steps.map((step, i) => (
        <>
          <div class="group relative flex-1 rounded-2xl border border-white/10 bg-white/5 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-white/20 hover:bg-white/10">
            <span class="mb-3 block text-3xl font-bold text-white/10 transition-colors duration-300 group-hover:text-{step.color}-400/20">{step.number}</span>
            <h3 class="mb-2 text-lg font-semibold text-white">{step.title}</h3>
            <p class="text-sm leading-relaxed text-slate-400">{step.description}</p>
          </div>
          {i < steps.length - 1 && (
            <div class="flex items-center justify-center lg:flex-col">
              <svg class="hidden h-5 w-5 text-white/20 lg:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
              <svg class="h-5 w-5 text-white/20 lg:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </div>
          )}
        </>
      ))}
    </div>
  </div>
</section>
