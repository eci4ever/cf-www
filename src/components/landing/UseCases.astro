---
const useCases = [
  {
    title: "SaaS Platforms",
    description:
      "Build multi-tenant SaaS platforms with authentication, dashboards, APIs, organizations, roles, and billing-ready architecture.",
  },
  {
    title: "Business Websites",
    description:
      "Launch fast, modern, and maintainable websites for companies, agencies, services, and organizations.",
  },
  {
    title: "Admin Systems",
    description:
      "Create internal dashboards, management systems, reporting tools, and secure admin panels.",
  },
  {
    title: "AI Automation",
    description:
      "Automate repetitive business processes using AI workflows, chatbots, assistants, and API integrations.",
  },
  {
    title: "Cloud Applications",
    description:
      "Deploy web apps, APIs, and backend services on reliable cloud infrastructure.",
  },
  {
    title: "Security Improvement",
    description:
      "Improve the security posture of websites, servers, applications, and cloud environments.",
  },
];
---

<section id="use-cases" class="relative px-4 py-24 sm:py-32">
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <h2 class="mb-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Built for businesses, teams, and digital products.
      </h2>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {useCases.map((useCase) => (
        <div class="group rounded-2xl border border-white/10 bg-white/5 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-white/20 hover:bg-white/10">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-cyan-500/10">
            <svg class="h-5 w-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 16.875h3.375m0 0h3.375m-3.375 0V13.5m0 3.375v3.375M6 10.5h2.25a2.25 2.25 0 002.25-2.25V6a2.25 2.25 0 00-2.25-2.25H6A2.25 2.25 0 003.75 6v2.25A2.25 2.25 0 006 10.5zm0 9.75h2.25A2.25 2.25 0 0010.5 18v-2.25a2.25 2.25 0 00-2.25-2.25H6a2.25 2.25 0 00-2.25 2.25V18A2.25 2.25 0 006 20.25zm9.75-9.75H18a2.25 2.25 0 002.25-2.25V6A2.25 2.25 0 0018 3.75h-2.25A2.25 2.25 0 0013.5 6v2.25a2.25 2.25 0 002.25 2.25z" />
            </svg>
          </div>
          <h3 class="mb-2 text-lg font-semibold text-white">{useCase.title}</h3>
          <p class="text-sm leading-relaxed text-slate-400">{useCase.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
