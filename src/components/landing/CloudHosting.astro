---
const features = [
  "Website and app hosting",
  "API hosting",
  "Cloud deployment support",
  "Domain and DNS setup",
  "SSL configuration",
  "Performance optimization",
  "Monitoring and maintenance",
  "Scalable infrastructure planning",
];

interface StatusItem {
  label: string;
  value: string;
  color: "green" | "cyan" | "blue" | "purple";
}

const statuses: StatusItem[] = [
  { label: "Production", value: "Live", color: "green" },
  { label: "SSL", value: "Active", color: "cyan" },
  { label: "DNS", value: "Configured", color: "blue" },
  { label: "Monitoring", value: "Enabled", color: "purple" },
];

const colorClasses: Record<string, { dot: string; text: string }> = {
  green: { dot: "bg-green-400", text: "text-green-400" },
  cyan: { dot: "bg-cyan-400", text: "text-cyan-400" },
  blue: { dot: "bg-blue-400", text: "text-blue-400" },
  purple: { dot: "bg-purple-400", text: "text-purple-400" },
};
---

<section id="hosting" class="relative px-4 py-24 sm:py-32">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(34,211,238,0.05),transparent_50%)]"></div>
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <h2 class="mb-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Fast, reliable hosting for websites, apps, and APIs.
      </h2>
      <p class="text-lg leading-relaxed text-slate-400">
        Deploy business websites, web applications, APIs, and cloud-native services with a reliable hosting setup built for performance, security, and maintainability.
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-2">
      <div class="space-y-4">
        {features.map((feature) => (
          <div class="flex items-start gap-3 rounded-xl border border-white/10 bg-white/5 p-4 transition-all duration-300 hover:border-white/20 hover:bg-white/10">
            <div class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-cyan-500/20">
              <svg class="h-3 w-3 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
            </div>
            <span class="text-sm text-slate-300">{feature}</span>
          </div>
        ))}
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
        <div class="mb-4 flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-cyan-400"></span>
          <span class="text-xs font-medium text-cyan-400">Infrastructure Status</span>
        </div>

        <div class="grid grid-cols-2 gap-4">
          {statuses.map((s) => {
            const cc = colorClasses[s.color];
            return (
              <div class="rounded-lg border border-white/5 bg-nimfi-950/50 p-4">
                <div class="text-xs text-slate-500">{s.label}</div>
                <div class={`mt-1 flex items-center gap-1.5 text-sm font-medium ${cc.text}`}>
                  <span class={`h-1.5 w-1.5 rounded-full ${cc.dot}`}></span>
                  {s.value}
                </div>
              </div>
            );
          })}
        </div>

        <div class="mt-4 rounded-lg border border-white/5 bg-nimfi-950/50 p-4 font-mono text-xs">
          <div class="text-slate-600">$ <span class="text-cyan-400">nimfi</span> status --hosting</div>
          <div class="mt-1 text-green-400">✓ All systems operational</div>
          <div class="text-slate-500">Region: Southeast Asia</div>
          <div class="text-slate-500">Nodes: 4</div>
          <div class="text-slate-500">Uptime: 99.9%</div>
        </div>
      </div>
    </div>
  </div>
</section>
