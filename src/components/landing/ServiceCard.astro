<div class="group relative overflow-hidden rounded-2xl border border-border bg-surface p-6 transition-all duration-300 hover:-translate-y-1 hover:border-border-hover hover:bg-surface-hover sm:p-8">
  <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-accent-soft">
