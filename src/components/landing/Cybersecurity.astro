---
const features = [
  "Security hardening",
  "Vulnerability assessment",
  "Access control review",
  "Secure server configuration",
  "Cloud security best practices",
  "Website and API protection",
  "Monitoring and incident readiness",
  "Authentication and authorization review",
];

interface StatItem {
  label: string;
  value: string;
  color: "emerald" | "green" | "cyan" | "blue";
}

const stats: StatItem[] = [
  { label: "Security Score", value: "98%", color: "emerald" },
  { label: "Threat Monitoring", value: "Enabled", color: "green" },
  { label: "SSL Status", value: "Valid", color: "cyan" },
  { label: "Access Control", value: "Reviewed", color: "blue" },
];

const colorClasses: Record<string, string> = {
  emerald: "text-emerald-400",
  green: "text-green-400",
  cyan: "text-cyan-400",
  blue: "text-blue-400",
};
---

<section id="cybersecurity" class="relative px-4 py-24 sm:py-32">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(16,185,129,0.05),transparent_50%)]"></div>
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <h2 class="mb-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Security built into every layer.
      </h2>
      <p class="text-lg leading-relaxed text-slate-400">
        Protect your digital platforms with secure configuration, access control, hardening, monitoring, and practical cybersecurity best practices.
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-2">
      <div class="space-y-4">
        {features.map((feature) => (
          <div class="flex items-start gap-3 rounded-xl border border-white/10 bg-white/5 p-4 transition-all duration-300 hover:border-white/20 hover:bg-white/10">
            <div class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/20">
              <svg class="h-3 w-3 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
            </div>
            <span class="text-sm text-slate-300">{feature}</span>
          </div>
        ))}
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
        <div class="mb-4 flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
          <span class="text-xs font-medium text-emerald-400">Security Dashboard</span>
        </div>

        <div class="grid grid-cols-2 gap-4">
          {stats.map((s) => (
            <div class="rounded-lg border border-white/5 bg-nimfi-950/50 p-4">
              <div class="text-xs text-slate-500">{s.label}</div>
              <div class={`mt-1 text-sm font-medium ${colorClasses[s.color]}`}>{s.value}</div>
            </div>
          ))}
        </div>

        <div class="mt-4 rounded-lg border border-emerald-500/10 bg-emerald-500/5 p-4 text-center text-sm text-emerald-400">
          Vulnerabilities: 0 Critical
        </div>
      </div>
    </div>
  </div>
</section>
