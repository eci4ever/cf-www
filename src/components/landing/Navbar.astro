---
import ThemeToggle from "../ThemeToggle.astro";
---

<nav class="fixed top-0 left-0 right-0 z-50 pl-[env(safe-area-inset-left)] pr-[env(safe-area-inset-right)]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mt-4 flex items-center justify-between rounded-2xl border border-border bg-page/70 px-6 py-3 backdrop-blur-xl">
      <a href="/" translate="no" class="flex items-center gap-2 text-lg font-semibold tracking-tight text-text-primary">
        <svg class="h-6 w-6" viewBox="0 0 48 48" fill="none" aria-hidden="true">
          <rect width="48" height="48" rx="12" class="fill-text-primary" />
          <path d="M14 33V22C14 17.6 16.9 15 20.5 15C24.1 15 27 17.6 27 22V33" class="stroke-page" stroke-width="5" stroke-linecap="round" />
          <circle cx="34.5" cy="32.5" r="2.8" class="fill-page" />
        </svg>
        nimfi<span class="text-accent">.dev</span>
      </a>

      <div class="hidden items-center gap-8 md:flex">
        <a href="#services" class="text-sm text-text-muted transition-colors duration-200 hover:text-text-primary">Services</a>
        <a href="#hosting" class="text-sm text-text-muted transition-colors duration-200 hover:text-text-primary">Hosting</a>
        <a href="#projects" class="text-sm text-text-muted transition-colors duration-200 hover:text-text-primary">Work</a>
        <a href="https://blog.nimfi.dev" target="_blank" rel="noopener noreferrer" class="text-sm text-text-muted transition-colors duration-200 hover:text-text-primary">Blog</a>
        <a href="#contact" class="text-sm text-text-muted transition-colors duration-200 hover:text-text-primary">Contact</a>
      </div>

      <div class="flex items-center gap-2">
        <div class="hidden items-center gap-3 md:flex">
          <a
            href="#projects"
            class="inline-flex items-center gap-2 rounded-lg bg-accent-soft px-4 py-2 text-sm font-medium text-accent transition-[filter] duration-300 hover:bg-accent-soft hover:brightness-110"
          >
            Projects
            <svg class="h-4 w-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
            </svg>
          </a>
        </div>

        <ThemeToggle />

        <button id="menu-toggle" class="flex items-center justify-center p-2 text-text-muted md:hidden" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg id="menu-icon" class="h-6 w-6" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
          <svg id="close-icon" class="hidden h-6 w-6" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="mx-auto mt-2 hidden max-w-7xl animate-[menu-in_200ms_ease-out] px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-2 rounded-2xl border border-border bg-page/90 px-6 py-4 backdrop-blur-xl">
      <a href="#services" class="rounded-lg px-3 py-2 text-sm text-text-muted transition-colors duration-200 hover:bg-surface-hover hover:text-text-primary">Services</a>
      <a href="#hosting" class="rounded-lg px-3 py-2 text-sm text-text-muted transition-colors duration-200 hover:bg-surface-hover hover:text-text-primary">Hosting</a>
      <a href="#projects" class="rounded-lg px-3 py-2 text-sm text-text-muted transition-colors duration-200 hover:bg-surface-hover hover:text-text-primary">Work</a>
      <a href="https://blog.nimfi.dev" target="_blank" rel="noopener noreferrer" class="rounded-lg px-3 py-2 text-sm text-text-muted transition-colors duration-200 hover:bg-surface-hover hover:text-text-primary">Blog</a>
      <a href="#contact" class="rounded-lg px-3 py-2 text-sm text-text-muted transition-colors duration-200 hover:bg-surface-hover hover:text-text-primary">Contact</a>
      <a
        href="#projects"
        class="mt-2 inline-flex items-center justify-center gap-2 rounded-lg bg-accent-soft px-4 py-2 text-sm font-medium text-accent transition-[filter] duration-300 hover:brightness-110"
      >
        Projects
        <svg class="h-4 w-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
        </svg>
      </a>
    </div>
  </div>
</nav>

<script>
  let controller: AbortController | undefined;

  function setupMobileMenu() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    const menuIcon = document.getElementById("menu-icon");
    const closeIcon = document.getElementById("close-icon");

    if (!toggle || !menu) return;

    toggle.addEventListener(
      "click",
      () => {
        const isOpen = !menu.classList.contains("hidden");
        menu.classList.toggle("hidden");
        menuIcon?.classList.toggle("hidden");
        closeIcon?.classList.toggle("hidden");
        toggle.setAttribute("aria-expanded", String(!isOpen));
      },
      { signal }
    );

    document.querySelectorAll("#mobile-menu a").forEach((link) => {
      link.addEventListener(
        "click",
        () => {
          menu.classList.add("hidden");
          menuIcon?.classList.remove("hidden");
          closeIcon?.classList.add("hidden");
          toggle.setAttribute("aria-expanded", "false");
        },
        { signal }
      );
    });
  }

  // Rebind selepas setiap navigasi ClientRouter — DOM diganti sepenuhnya.
  document.addEventListener("astro:page-load", setupMobileMenu);
</script>
