---
const features = [
  "AI chatbots and assistants",
  "Document and data processing",
  "Business workflow automation",
  "AI-powered customer support",
  "Internal knowledge assistants",
  "API-based AI integrations",
];
---

<section id="ai-platform" class="relative px-4 py-24 sm:py-32">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(168,85,247,0.06),transparent_50%)]"></div>
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <h2 class="mb-4 text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        AI-powered tools for modern operations.
      </h2>
      <p class="text-lg leading-relaxed text-text-muted">
        Nimfi.dev helps businesses design and deploy AI workflows that reduce manual work, improve response time, and unlock smarter digital experiences.
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-2">
      <div class="space-y-4">
        {features.map((feature) => (
          <div class="flex items-start gap-3 rounded-xl border border-border bg-surface p-4 transition-all duration-300 hover:border-border-hover hover:bg-surface-hover">
            <div class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-purple-soft">
              <svg class="h-3 w-3 text-purple-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
            </div>
            <span class="text-sm text-text-secondary">{feature}</span>
          </div>
        ))}
      </div>

      <div class="rounded-2xl border border-border bg-surface p-6 backdrop-blur-sm">
        <div class="mb-4 flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-purple-400"></span>
          <span class="text-xs font-medium text-purple-400">AI Workflow</span>
        </div>

        <div class="mb-6 flex items-center justify-between rounded-lg border border-white/5 bg-nimfi-950/50 px-4 py-2 font-mono text-xs text-slate-500">
          <span>Input</span>
          <svg class="h-4 w-4 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
          <span>Process</span>
          <svg class="h-4 w-4 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
          <span class="text-cyan-400">AI Decision</span>
          <svg class="h-4 w-4 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
          <span>Automation</span>
          <svg class="h-4 w-4 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
          <span>Result</span>
        </div>

        <div class="grid grid-cols-3 gap-4">
          <div class="rounded-lg border border-border-faint bg-surface-strong p-4 text-center">
            <div class="text-2xl font-bold text-text-primary">1,284</div>
            <div class="mt-1 text-xs text-text-faint">AI Tasks Completed</div>
            <div class="mt-1 text-xs text-success">+12% this month</div>
          </div>
          <div class="rounded-lg border border-border-faint bg-surface-strong p-4 text-center">
            <div class="text-2xl font-bold text-text-primary">1.8s</div>
            <div class="mt-1 text-xs text-text-faint">Avg Response Time</div>
            <div class="mt-1 text-xs text-success">-0.3s vs last month</div>
          </div>
          <div class="rounded-lg border border-border-faint bg-surface-strong p-4 text-center">
            <div class="text-2xl font-bold text-text-primary">98.7%</div>
            <div class="mt-1 text-xs text-text-faint">Automation Success</div>
            <div class="mt-1 text-xs text-success">+0.5% improvement</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
