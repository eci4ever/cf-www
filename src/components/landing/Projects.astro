---
const projects = [
  {
    title: "Prepaid AI API Access",
    description: "Prepaid AI API platform — buy credits, use AI models, scale your applications with ease.",
    url: "https://app.nimfi.dev",
    tag: "Live",
    tagColor: "cyan",
  },
  {
    title: "Emasa",
    description: "Official portal for Emasa — digital services and information platform.",
    url: "https://emasa.nimfi.dev",
    tag: "Live",
    tagColor: "green",
  },
];
---

<section id="projects" class="relative px-4 py-24 sm:py-32">
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <h2 class="mb-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Explore our projects.
      </h2>
      <p class="text-lg leading-relaxed text-slate-400">
        live projects built and maintained by Nimfi.dev.
      </p>
    </div>

    <div class="mx-auto grid max-w-3xl gap-6 sm:grid-cols-2">
      {projects.map((project) => (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-2xl border border-white/10 bg-white/5 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-cyan-500/30 hover:bg-white/10 sm:p-8"
        >
          <div class="mb-3 flex items-center justify-between">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-cyan-500/10">
              <svg class="h-5 w-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H6a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 006 21h10.5a2.25 2.25 0 002.25-2.25V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
            </div>
            <span class="flex items-center gap-1.5 rounded-full border border-green-500/20 bg-green-500/10 px-2.5 py-0.5 text-xs font-medium text-green-400">
              <span class="h-1.5 w-1.5 rounded-full bg-green-400"></span>
              {project.tag}
            </span>
          </div>
          <h3 class="mb-2 text-lg font-semibold text-white group-hover:text-cyan-400">{project.title}</h3>
          <p class="text-sm leading-relaxed text-slate-400">{project.description}</p>
          <div class="mt-4 flex items-center gap-1 text-sm text-cyan-400 opacity-0 transition-all duration-300 group-hover:opacity-100">
            Visit site
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H6a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 006 21h10.5a2.25 2.25 0 002.25-2.25V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
