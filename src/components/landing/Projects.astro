---
const projects = [
  {
    title: "Prepaid AI API Access",
    description: "Prepaid AI API platform — buy credits, use AI models, scale your applications with ease.",
    url: "https://app.nimfi.dev",
    domain: "app.nimfi.dev",
    tag: "Live",
  },
  {
    title: "Tapme",
    description: "Tapme — digital product built and maintained by Nimfi.dev.",
    url: "https://tapme.nimfi.dev",
    domain: "tapme.nimfi.dev",
    tag: "Live",
  },
];
---

<section id="projects" class="relative px-4 py-24 sm:py-32">
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <h2 class="mb-4 text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        Explore our projects.
      </h2>
      <p class="text-lg leading-relaxed text-text-muted">
        live projects built and maintained by Nimfi.dev.
      </p>
    </div>

    <div class="mx-auto grid max-w-3xl gap-6 sm:grid-cols-2">
      {projects.map((project) => (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col overflow-hidden rounded-2xl border border-border bg-surface transition-all duration-300 hover:-translate-y-1 hover:border-cyan-500/40 hover:bg-surface-hover"
        >
          <div class="flex items-center gap-1.5 border-b border-border-faint bg-surface-strong px-4 py-3">
            <span class="h-2.5 w-2.5 rounded-full bg-red-500/70"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-yellow-500/70"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-green-500/70"></span>
            <span class="ml-2 truncate font-mono text-xs text-text-faint">{project.domain}</span>
          </div>

          <div class="p-6 sm:p-8">
            <div class="mb-3 flex items-center justify-between">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent-soft">
                <svg class="h-5 w-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H6a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 006 21h10.5a2.25 2.25 0 002.25-2.25V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                </svg>
              </div>
              <span class="flex items-center gap-1.5 rounded-full border border-success-soft bg-success-soft px-2.5 py-0.5 text-xs font-medium text-success">
                <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
                {project.tag}
              </span>
            </div>
            <h3 class="mb-2 text-lg font-semibold text-text-primary group-hover:text-accent">{project.title}</h3>
            <p class="text-sm leading-relaxed text-text-muted">{project.description}</p>
            <div class="mt-4 flex items-center gap-1 text-sm text-accent opacity-0 transition-all duration-300 group-hover:opacity-100">
              Visit site
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H6a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 006 21h10.5a2.25 2.25 0 002.25-2.25V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
