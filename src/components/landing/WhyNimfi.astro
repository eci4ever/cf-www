---
const reasons = [
  {
    title: "Developer-first approach",
    description:
      "Every project is designed with clean architecture, maintainable code, and long-term scalability in mind.",
    icon: "terminal",
  },
  {
    title: "Full-stack capability",
    description:
      "From frontend and backend to hosting, AI, integrations, and security, Nimfi.dev supports the full digital product lifecycle.",
    icon: "layers",
  },
  {
    title: "Cloud-native mindset",
    description:
      "Build and deploy platforms using modern infrastructure practices, scalable hosting, and reliable web technologies.",
    icon: "cloud",
  },
  {
    title: "Security-aware delivery",
    description:
      "Security is considered from planning to deployment, not treated as an afterthought.",
    icon: "shield",
  },
];

const iconPaths: Record<string, string> = {
  terminal:
    "m6.75 7.5 3 2.25-3 2.25m4.5 4.5H12m9-4.5v9a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18.75V5.25a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 5.25v9Z",
  layers:
    "M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z",
  cloud:
    "M2.25 15a4.5 4.5 0 0 0 4.5 4.5H18a3.75 3.75 0 0 0 1.332-7.257 3 3 0 0 0-3.758-3.848 5.25 5.25 0 0 0-10.233 2.33A4.502 4.502 0 0 0 2.25 15Z",
  shield:
    "M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z",
};
---

<section id="why-nimfi" class="relative px-4 py-24 sm:py-32">
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <h2 class="mb-4 text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        Why teams choose Nimfi.dev
      </h2>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      {reasons.map((reason) => (
        <div class="group rounded-2xl border border-border bg-surface p-6 transition-all duration-300 hover:-translate-y-1 hover:border-border-hover hover:bg-surface-hover sm:p-8">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-accent-soft">
            <svg class="h-5 w-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[reason.icon]} />
            </svg>
          </div>
          <h3 class="mb-2 text-lg font-semibold text-text-primary">{reason.title}</h3>
          <p class="text-sm leading-relaxed text-text-muted">{reason.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
