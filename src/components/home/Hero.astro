---
const starters = [
  { label: "Business Website", prompt: "I need a business website for " },
  { label: "SaaS Platform", prompt: "I want to build a SaaS platform that " },
  { label: "AI Automation", prompt: "I want to automate this workflow with AI: " },
  { label: "Cloud Hosting", prompt: "I need hosting and deployment for " },
  { label: "Cybersecurity", prompt: "I need a security review for " },
];
---

<section class="relative flex flex-col items-center px-6 pb-24 pt-14 text-center sm:pt-20">
  <h1
    class="rise rise-1 max-w-4xl font-serif text-5xl leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl"
  >
    <span class="bg-gradient-to-b from-ink via-ink to-ink/35 bg-clip-text text-transparent">
      Apa yang kami boleh bina untuk anda?
    </span>
  </h1>

  <p class="rise rise-2 mt-6 max-w-xl text-lg text-balance text-ink-muted">
    Nimfi.dev builds software, AI products, and cloud infrastructure for businesses — tell us what you have in mind.
  </p>

  <form
    id="project-form"
    class="rise rise-3 mt-10 w-full max-w-3xl rounded-2xl border border-line bg-surface text-left shadow-[0_1px_2px_rgba(28,28,26,0.04),0_8px_24px_rgba(28,28,26,0.06)] transition-colors duration-200 focus-within:border-line-hover"
  >
    <label for="project-idea" class="sr-only">Describe your project</label>
    <textarea
      id="project-idea"
      name="idea"
      rows="3"
      placeholder="Tell us what you want to build…"
      class="block w-full resize-none bg-transparent px-5 pb-2 pt-5 text-base text-ink placeholder:text-ink-faint focus:outline-none"
    ></textarea>
    <div class="flex items-center justify-between px-4 pb-4">
      <p class="pl-1 text-xs text-ink-faint">
        Opens an email to <span class="font-medium text-ink-muted">support@nimfi.dev</span>
      </p>
      <button
        type="submit"
        aria-label="Send project idea"
        class="flex h-10 w-10 items-center justify-center rounded-full bg-ink text-page transition-[transform,opacity] duration-200 hover:opacity-85 hover:-translate-y-0.5"
      >
        <svg class="h-4 w-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 19.5v-15m0 0l-6.75 6.75M12 4.5l6.75 6.75" />
        </svg>
      </button>
    </div>
  </form>

  <div class="rise rise-4 mt-8 flex flex-wrap items-center justify-center gap-3" role="list" aria-label="Project starters">
    {starters.map((starter) => (
      <button
        type="button"
        role="listitem"
        data-prompt={starter.prompt}
        class="starter-chip rounded-full border border-line bg-surface px-4 py-2 text-sm text-ink-soft transition-[border-color,background-color,color] duration-200 hover:border-line-hover hover:bg-surface-hover hover:text-ink"
      >
        {starter.label}
      </button>
    ))}
  </div>

  <p class="rise rise-5 mt-12 font-mono text-xs text-ink-faint">
    Astro · TypeScript · Hono · PostgreSQL · Cloudflare
  </p>
</section>

<script>
  const form = document.getElementById("project-form") as HTMLFormElement | null;
  const idea = document.getElementById("project-idea") as HTMLTextAreaElement | null;

  function sendByEmail(): void {
    if (!idea) return;
    const text = idea.value.trim();
    const subject = encodeURIComponent("Project enquiry — nimfi.dev");
    const body = encodeURIComponent(text || "Hi Nimfi.dev,\n\nI'd like to build:\n\n");
    window.location.href = `mailto:support@nimfi.dev?subject=${subject}&body=${body}`;
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    sendByEmail();
  });

  idea?.addEventListener("keydown", (event) => {
    if (event.key === "Enter" && !event.shiftKey) {
      event.preventDefault();
      sendByEmail();
    }
  });

  document.querySelectorAll<HTMLElement>(".starter-chip").forEach((chip) => {
    chip.addEventListener("click", () => {
      if (!idea) return;
      idea.value = chip.dataset.prompt ?? "";
      idea.focus();
    });
  });
</script>
