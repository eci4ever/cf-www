---
const projects = [
  {
    title: "Prepaid AI API Access",
    blurb: "Buy credits, use AI models, scale your applications.",
    url: "https://app.nimfi.dev",
    domain: "app.nimfi.dev",
    cover: "bg-[radial-gradient(120%_120%_at_50%_0%,#10202a_0%,#0b1216_55%,#080a0c_100%)]",
    accent: "text-cyan-300",
    glow: "bg-[radial-gradient(60%_45%_at_50%_0%,rgba(34,211,238,0.22),transparent_70%)]",
  },
  {
    title: "Tapme",
    blurb: "Digital product built and maintained by Nimfi.dev.",
    url: "https://tapme.nimfi.dev",
    domain: "tapme.nimfi.dev",
    cover: "bg-[radial-gradient(120%_120%_at_50%_0%,#131b2e_0%,#0c0f18_55%,#08090d_100%)]",
    accent: "text-blue-300",
    glow: "bg-[radial-gradient(60%_45%_at_50%_0%,rgba(96,165,250,0.2),transparent_70%)]",
  },
  {
    title: "Nimfi Koop",
    blurb: "Cooperative platform — members, roles, and invitations in one place.",
    url: "https://cf-org.nimfi.dev",
    domain: "cf-org.nimfi.dev",
    cover: "bg-[radial-gradient(120%_120%_at_50%_0%,#12231a_0%,#0b130e_55%,#080b09_100%)]",
    accent: "text-emerald-300",
    glow: "bg-[radial-gradient(60%_45%_at_50%_0%,rgba(52,211,153,0.2),transparent_70%)]",
  },
];
---

<section class="mx-auto w-full max-w-5xl px-6 pb-6">
  <p class="rise rise-5 mb-5 text-center font-mono text-xs uppercase tracking-[0.2em] text-ink-faint">
    Selected work
  </p>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {projects.map((project, i) => (
      <a
        href={project.url}
        target="_blank"
        rel="noopener noreferrer"
        class:list={["group relative flex min-h-56 flex-col justify-between overflow-hidden rounded-2xl p-5 ring-1 ring-white/10 transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-[0_16px_40px_rgba(28,28,26,0.18)]", project.cover, i === 0 && "rise rise-4", i === 1 && "rise rise-5", i === 2 && "rise rise-5"]}
      >
        <div class:list={["pointer-events-none absolute inset-0", project.glow]} aria-hidden="true"></div>

        <div class="relative flex items-center justify-between">
          <span class="font-mono text-xs text-white/60">{project.domain}</span>
          <span class="flex items-center gap-1.5 text-xs font-medium text-white/70">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            Live
          </span>
        </div>

        <div class="relative">
          <h2 class="font-serif text-3xl leading-tight text-white">{project.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-white/60">{project.blurb}</p>
          <span class={`mt-4 inline-flex items-center gap-1.5 text-sm font-medium ${project.accent} opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100`}>
            Visit
            <svg class="h-3.5 w-3.5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H6a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 006 21h10.5a2.25 2.25 0 002.25-2.25V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>
          </span>
        </div>
      </a>
    ))}
  </div>
</section>
