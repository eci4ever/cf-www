<div class="relative flex items-center">
  <button
    id="theme-toggle"
    class="flex items-center justify-center rounded-lg p-2 text-text-muted transition-colors duration-200 hover:bg-surface-hover hover:text-text-primary"
    aria-label="Toggle theme"
    aria-expanded="false"
    aria-haspopup="menu"
  >
    <svg id="icon-sun" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
    </svg>
    <svg id="icon-moon" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
    </svg>
  </button>

  <div id="theme-menu" class="absolute right-0 top-full z-50 mt-2 hidden w-40 rounded-xl border border-border bg-surface p-1 shadow-xl shadow-black/10 backdrop-blur-xl">
    <button
      data-theme="light"
      class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm text-text-muted transition-colors duration-200 hover:bg-surface-hover hover:text-text-primary"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
      </svg>
      Light
    </button>
    <button
      data-theme="dark"
      class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm text-text-muted transition-colors duration-200 hover:bg-surface-hover hover:text-text-primary"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
      </svg>
      Dark
    </button>
    <button
      data-theme="system"
      class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm text-text-muted transition-colors duration-200 hover:bg-surface-hover hover:text-text-primary"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25" />
      </svg>
      System
    </button>
  </div>
</div>

<script>
  const btn = document.getElementById("theme-toggle");
  const menu = document.getElementById("theme-menu");
  const options = Array.from(document.querySelectorAll("[data-theme]"));
  const btnSun = document.getElementById("icon-sun");
  const btnMoon = document.getElementById("icon-moon");

  function storedTheme(): string {
    const stored = localStorage.getItem("theme");
    return stored === "dark" || stored === "light" ? stored : "system";
  }

  function isSystemDark(): boolean {
    return window.matchMedia("(prefers-color-scheme: dark)").matches;
  }

  function apply(theme: string): void {
    const dark = theme === "dark" || (theme === "system" && isSystemDark());

    document.documentElement.classList.toggle("dark", dark);
    document.documentElement.style.colorScheme = dark ? "dark" : "light";

    btnSun?.classList.toggle("hidden", dark);
    btnMoon?.classList.toggle("hidden", !dark);

    options.forEach((option) => {
      const active = option.dataset.theme === theme;
      option.classList.toggle("text-accent", active);
      option.classList.toggle("bg-accent-soft", active);
      option.classList.toggle("text-text-muted", !active);
      option.setAttribute("aria-pressed", String(active));
    });

    if (theme === "dark") {
      localStorage.setItem("theme", "dark");
    } else if (theme === "light") {
      localStorage.setItem("theme", "light");
    } else {
      localStorage.removeItem("theme");
    }
  }

  function toggleMenu(open: boolean): void {
    menu?.classList.toggle("hidden", !open);
    btn?.setAttribute("aria-expanded", String(open));
  }

  btn?.addEventListener("click", () => {
    const isOpen = !menu?.classList.contains("hidden");
    toggleMenu(!isOpen);
  });

  options.forEach((option) => {
    option.addEventListener("click", () => {
      apply(option.dataset.theme ?? "system");
      toggleMenu(false);
    });
  });

  document.addEventListener("click", (event) => {
    if (!menu || !btn) return;
    const target = event.target as Node;
    if (!menu.contains(target) && !btn.contains(target)) {
      toggleMenu(false);
    }
  });

  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", () => {
      if (storedTheme() === "system") apply("system");
    });

  apply(storedTheme());
</script>
